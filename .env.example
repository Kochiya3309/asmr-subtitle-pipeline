# 将本文件复制为 .env，再填写实际配置。
# .env 已被 .gitignore 忽略；不要提交、截图或外传其中的真实密钥。
# 已存在的系统/进程环境变量优先于 .env 中的同名配置。
# 为兼容所有子脚本，布尔开关统一使用 0/1。
# 由 run_all.py 解析的开关也接受 false/true、no/yes、off/on；但 ENABLE_LONG_CUE_ALIGNMENT 由 STEP1 直接读取，只可靠接受 0/1。

# ===== LLM 配置（V3.6 起支持 OpenAI 兼容 API）=====

# 必填：LLM 服务商的 API Key。DeepSeek 用户可在 platform.deepseek.com 申请。
OPENAI_API_KEY=

# 可选：OpenAI 兼容接口的基础地址。留空时默认使用 https://api.deepseek.com。
# 示例：OpenAI=https://api.openai.com/v1；硅基流动=https://api.siliconflow.cn/v1；Moonshot=https://api.moonshot.cn/v1。
OPENAI_BASE_URL=

# 可选：服务商提供的模型标识。留空时默认使用 deepseek-v4-pro；更换服务商时通常需要填写。
OPENAI_MODEL=

# 是否发送 DeepSeek 非标准 thinking 参数。默认 0；只有服务商明确支持时才能设为 1，否则可能返回请求错误。
OPENAI_ENABLE_THINKING=0

# 可选：单次 LLM 响应的最大输出 token 数。留空时默认 131072；不得超过所选模型/服务商限制。
OPENAI_MAX_TOKENS=

# 旧版兼容项：仅在 OPENAI_API_KEY 为空时作为备用密钥读取；新部署不需要启用。
# DEEPSEEK_API_KEY=

# ===== 联网搜索（可选）=====

# Tavily API Key。留空即不使用 Tavily；可在 https://app.tavily.com 申请。
TAVILY_API_KEY=

# Exa API Key。留空即不使用 Exa；可在 https://dashboard.exa.ai 申请。
EXA_API_KEY=

# 是否允许审校阶段按需联网搜索。默认 0；设为 1 后只调用已配置密钥的 provider，两者都有时并行查询并按 URL 去重。
# 搜索服务会收到生成的查询词，因此处理隐私或 NSFW 内容时建议保持关闭。
ENABLE_SEARCH=0

# ===== 台本模式 =====

# 台本功能总开关。默认 0；为 0 时不读取 scripts/，也不会自动探测是否存在台本。
ENABLE_SCRIPT=0

# 是否执行 STEP0 台本匹配与总台本分割。仅在 ENABLE_SCRIPT=1 时有效；通常与台本模式一起开启。
STEP0_MATCH_SCRIPTS=0

# 台本目录。相对路径以启动流水线时的项目工作目录为基准；start.bat 会先切换到项目根目录。
SCRIPT_DIR=./scripts

# 未能匹配/拆分时，是否把一份未使用的完整台本作为兜底候选附给未匹配音频。默认 1；可能增加误匹配，需关注 mapping 确认结果。
SCRIPT_FALLBACK_FULL=1

# 是否忽略已验证的拆分缓存并重新匹配/分割。默认 0；设为 1 会清理 output/scripts_split/ 中旧的拆分 txt 后重建。
SCRIPT_FORCE_RESPLIT=0

# 是否允许非交互任务自动确认 script_mapping.json。默认 0（fail-closed）；无人值守且明确接受自动映射时才设为 1。
SCRIPT_AUTO_VERIFY=0

# ===== ASR、证据、幻觉隔离与救援 =====

# 是否先对音频执行 16 kHz 单声道化、高通滤波、保守降噪和响度归一化。默认 1；配置变化会使预处理/ASR 缓存失效。
ENABLE_AUDIO_PREPROCESS=1

# 是否保存双模型候选、原生置信指标、来源、对齐窗口和审计 manifest。默认 1；关闭后幻觉过滤和救援证据链无法工作。
ENABLE_ASR_EVIDENCE=1

# 是否隔离缺少独立证据支持的高精度固定幻觉模板。默认 1；只影响融合输入，不删除原始 ASR 候选。
# 依赖 ENABLE_ASR_EVIDENCE=1；关闭证据时本开关不会生效。
ENABLE_HALLUCINATION_FILTER=1

# 是否对可疑窗口执行定向救援。默认 1：先运行 large-v3 无 VAD，再仅对 V3 检出可能语音的窗口运行 Turbo 对照。
# 依赖 ENABLE_ASR_EVIDENCE=1；不会对整段音频运行 Turbo 无 VAD 全局扫描。
ENABLE_ASR_RESCUE=1

# 是否启用实验性确定性融合时间轴。默认 0；设为 1 后 LLM 只选文本/证据 ID，时间戳由本地代码解析。
# 更改此项会使融合缓存失效；台本正式融合仍使用台本专用路径。
ENABLE_DETERMINISTIC_TIMELINE=0

# 注意：救援窗口长度/重叠、initial prompt、hotwords 和 VAD 参数目前在 run_all.py 中定义并覆盖同名环境变量，不能在此配置。

# ===== 异常长字幕局部定时 =====

# 是否检测并处理超过阈值的长字幕。默认 1；正常匹配的台本模式会跳过，无台本或台本 mismatch 回退结果才会进入。
ENABLE_LONG_CUE_ALIGNMENT=1

# 长字幕处理模式。apply=应用通过本地校验的边界；shadow=只生成审计报告、不修改 SRT。仅允许 apply 或 shadow。
LONG_CUE_ALIGNMENT_MODE=apply

# 触发长字幕检查的时长阈值，单位秒，必须大于 0。默认 15。
LONG_CUE_MAX_SECONDS=15

# ===== 正式流水线阶段 =====

# 是否执行 STEP1：音频预处理、large-v3 + large-v3-turbo 双 ASR、证据/救援与融合。默认 1。
STEP1_ENSEMBLE=1

# 是否允许执行 STEP2 日文二审。默认 1；台本完全匹配时自动跳过，只有 mismatch 文件进入二审。
STEP2_REVIEW_JP=1

# 是否执行 STEP3：日译简中和逐段翻译审校。默认 1。
STEP3_TRANSLATE=1

# 是否允许执行 STEP3.5 浏览器人工复核。默认 1，但只有 ENABLE_HUMAN_REVIEW=1 时才真正执行。
STEP35_HUMAN_REVIEW=1

# 是否执行 STEP4：全篇中日双语终审并生成 *_final.srt。默认 1。
STEP4_FINAL=1

# 是否执行 STEP5：规则扫描最终字幕。默认 1；发现严重问题时流水线返回失败。
STEP5_VALIDATE=1

# 是否执行 STEP6：从最终双语字幕生成 *_cn_only.srt。默认 1。
STEP6_STRIP=1

# ===== 人工复核（可选）=====

# 人工复核总开关。默认 0；设为 1 后在 STEP3 与 STEP4 之间逐个打开仅绑定 127.0.0.1 的本地审核页面。
# 页面本身不上传音频或字幕；未完成提交时流水线安全暂停，再次运行可从当前缓存恢复。
ENABLE_HUMAN_REVIEW=0

# 本地审核服务器端口。默认 8765，便于 localStorage 草稿跨暂停/重启复用；设为 0 时由系统随机分配可用端口。
HUMAN_REVIEW_PORT=8765

# 是否在人工复核前正式分类台本结构并对齐时间轴，用于过滤无意义边界误报。默认 0。
# 仅在 ENABLE_SCRIPT=1 且 ENABLE_HUMAN_REVIEW=1 时有效；开启后会执行 STEP3.25 并调用 LLM。
ENABLE_SCRIPT_REVIEW_FILTER=0

# ===== 台本结构影子分析（可选）=====

# 是否在正式 STEP0-6 完成后旁路分类台本并对齐 ASR 时间窗。默认 0，且仅在 ENABLE_SCRIPT=1 时运行；结果仅供审计，不改变正式字幕或时间轴。
# 输出 *_script_units.json（dialogue/action/psychology/separator/unknown）和 *_script_alignment.json；会产生额外 LLM 调用。
ENABLE_SCRIPT_UNITS_SHADOW=0

# 台本结构分类/对齐进程的总超时，单位秒，必须为正整数。默认 120；末尾影子分析超时不会使已完成的正式流水线失败。
SCRIPT_UNITS_TOTAL_TIMEOUT_SECONDS=120
