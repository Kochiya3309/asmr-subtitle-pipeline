# Copy this file to .env. Configuration reference:
# English: docs/configuration.md
# 简体中文：docs/configuration.zh-CN.md
# .env may contain secrets. Do not commit or share it. Use 0 or 1 for switches.

# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_ENABLE_THINKING=0
OPENAI_MAX_TOKENS=

# Optional search. Keep disabled for private or NSFW material unless needed.
TAVILY_API_KEY=
EXA_API_KEY=
ENABLE_SEARCH=0

# Input, output, and standalone export paths.
AUDIO_DIR=./audio
VIDEO_DIR=./video
OUTPUT_DIR=./output
SRT_TRANSFER_DIR=./output/_transfer
ENABLE_VIDEO_PREP=0

# Script mode
ENABLE_SCRIPT=0
STEP0_MATCH_SCRIPTS=0
SCRIPT_DIR=./scripts
SCRIPT_FALLBACK_FULL=1
SCRIPT_FORCE_RESPLIT=0
SCRIPT_AUTO_VERIFY=0

# ASR and timing
ENABLE_AUDIO_PREPROCESS=1
ENABLE_ASR_EVIDENCE=1
ENABLE_HALLUCINATION_FILTER=1
ENABLE_ASR_RESCUE=1
ENABLE_DETERMINISTIC_TIMELINE=0
ENABLE_LONG_CUE_ALIGNMENT=1
LONG_CUE_ALIGNMENT_MODE=apply
LONG_CUE_MAX_SECONDS=15

# Pipeline stages and human review
STEP1_ENSEMBLE=1
STEP2_REVIEW_JP=1
STEP3_TRANSLATE=1
STEP35_HUMAN_REVIEW=1
STEP4_FINAL=1
STEP5_VALIDATE=1
STEP6_STRIP=1
STEP7_EXPORT_FINAL=1
STEP8_EXPORT_CN_ONLY=1
ENABLE_HUMAN_REVIEW=0
HUMAN_REVIEW_PORT=8765
ENABLE_SCRIPT_REVIEW_FILTER=0
ENABLE_SCRIPT_UNITS_SHADOW=0
SCRIPT_UNITS_TOTAL_TIMEOUT_SECONDS=120
