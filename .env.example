# 复制此文件为 .env 并填入真实 API Key
# .env 已在 .gitignore 中，不会被提交

# ===== LLM 配置（V3.6 起：任意 OpenAI 兼容 API）=====

# 必填。服务商的 API Key。
# DeepSeek 用户在 platform.deepseek.com 申请（sk- 开头）
OPENAI_API_KEY=

# 可选，默认 https://api.deepseek.com（DeepSeek 用户无需设置）。
# 换服务商示例：
#   OpenAI：https://api.openai.com/v1
#   硅基流动：https://api.siliconflow.cn/v1
#   Moonshot：https://api.moonshot.cn/v1
OPENAI_BASE_URL=

# 可选，默认 deepseek-v4-pro。按服务商提供的模型名填写（如 gpt-4o、kimi-k2 等）
OPENAI_MODEL=

# 思维链开关（DeepSeek 的非标准参数，OpenAI 等标准服务不认，默认关闭）。
# DeepSeek 等支持 thinking 参数的服务设 1；OpenAI 等标准服务保持 0（否则请求报错）
OPENAI_ENABLE_THINKING=0

# 可选，单次输出 token 上限，默认 131072。
# 按服务商支持范围调整（如 gpt-4o 填 16384）
OPENAI_MAX_TOKENS=

# 旧配置兼容：未设置 OPENAI_API_KEY 时自动回退读取 DEEPSEEK_API_KEY，新部署无需填写
# DEEPSEEK_API_KEY=

# ===== 联网搜索（可选，V3.5 起为 Tavily + Exa，两个都填时并行查询合并去重）=====
# Tavily：https://app.tavily.com 申请（tvly- 开头，每月 1000 次免费额度）
TAVILY_API_KEY=
# Exa：https://dashboard.exa.ai 申请（每月 1000 次免费额度）
EXA_API_KEY=
